# Port the HTTP server listens on
PORT=3001
# Comma separated origins allowed to call the REST API (bill-please web)
CORS_ORIGINS=http://localhost:3000
# Maximum accepted receipt image size in bytes (default 5 MB)
MAX_IMAGE_BYTES=5242880
# Requests per minute per client IP
RATE_LIMIT_PER_MINUTE=30
# Read client IP from X-Forwarded-For (enable only behind a reverse proxy)
TRUST_PROXY=false
# bill-please-ocr base URL and timeout
OCR_URL=http://localhost:8000
OCR_TIMEOUT_MS=20000
# Skip the LLM and answer 422 when the mean OCR confidence is lower than this
OCR_MIN_CONFIDENCE=0.6
# OpenAI compatible API (llama.cpp llm-server), model name and timeout
LLM_URL=http://localhost:8080/v1
LLM_MODEL=qwen3-4b-instruct-2507
LLM_TIMEOUT_MS=45000
# Bearer token, only for APIs that need one
LLM_API_KEY=
# reasoning_effort sent to the LLM. none turns thinking off. Leave empty to omit the field
LLM_REASONING_EFFORT=none
# gbnf: compact output grammar, llama.cpp only. json_schema: any OpenAI compatible API
LLM_OUTPUT_FORMAT=gbnf
# Cloudflare Turnstile secret key. Leave empty to skip the check on POST /api/receipts/scan
# Local / dev (behind Vercel Preview): Cloudflare's always-pass test secret below, paired
# with the web's test site key 1x00000000000000000000AA. Test-key results skip the action
# and hostname checks. Production: the real secret, from the prod Kubernetes Secret only.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Comma separated hostnames a token must come from, e.g. bill-please.chatree.dev. Empty accepts any
TURNSTILE_HOSTNAMES=
# Timeout for Cloudflare's siteverify call
TURNSTILE_TIMEOUT_MS=10000
# Log level: TRACE, DEBUG, INFO, WARN, ERROR or OFF
LOG_LEVEL=INFO
